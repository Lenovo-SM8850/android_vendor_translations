    <string name="low_latency_audio_slice_subtitle">AirPods の再接続が必要です。</string>
    <string name="head_gesture_call_answered_toast">ヘッドジェスチャーで通話に応答しました</string>
    <string name="head_gesture_call_rejected_toast">ヘッドジェスチャーで通話を拒否しました</string>
