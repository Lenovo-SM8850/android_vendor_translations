    <string name="settings_title">その他の設定</string>
    <string name="more_settings_subtitle">相対音量、自動耳検出など</string>
    <string name="automatic_ear_detection_title">自動耳検出</string>
    <string name="personalized_volume_title">音量のパーソナライズ</string>
    <string name="personalized_volume_summary">周囲の環境に合わせてメディアの音量を調整します。</string>
    <string name="conversational_awareness_title">会話感知</string>
    <string name="conversational_awareness_summary">話し始めるとメディアの音量を下げ、周囲のノイズを低減します。</string>
    <string name="relative_conversational_awareness_volume_title">相対音量</string>
    <string name="relative_conversational_awareness_volume_summary">最大音量ではなく、現在の音量に対する割合まで下げます。</string>
    <string name="conversational_awareness_pause_music_title">メディアを一時停止</string>
